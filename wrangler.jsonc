{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "svjengrs",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS"},
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "svjengrs"}],
  "routes": [
    {"pattern": "svjengrs.com", "custom_domain": true},
    {"pattern": "www.svjengrs.com", "custom_domain": true}
  ],
  "vars": {
    "ENQUIRY_NOTIFICATION_EMAIL": "svjengrs@gmail.com",
    "ENQUIRY_FROM_EMAIL": "SVJ Website <website@svjengrs.com>"
  }
}
